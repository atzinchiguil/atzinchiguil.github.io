library(fpp3)
library(tseries)            # adf.test, kpss.test
# ------------------------------------------------------------
# 0. Cargar las series como tsibble (índice mensual)
#    Trabajamos con el INPC DESDE 2010 (periodo estable).
# ------------------------------------------------------------
read.csv("/Users/atzinchiguil/Library/CloudStorage/OneDrive-ElColegiodeMéxicoA.C/Research/Time Series Course/Sesión 2/Datos/inflacion_inpc_mensual.csv") |>
mutate(mes = yearmonth(as.Date(fecha))) |>
as_tsibble(index = mes) |>
filter(year(mes) >= 2010) -> inpc
read.csv("/Users/atzinchiguil/Library/CloudStorage/OneDrive-ElColegiodeMéxicoA.C/Research/Time Series Course/Sesión 2/Datos/tipo_cambio_mensual.csv") |>
mutate(mes = yearmonth(as.Date(fecha))) |>
as_tsibble(index = mes) -> tc
# ------------------------------------------------------------
# 1. ¿Es estacionario el INPC?  (pruebas con hipótesis OPUESTAS)
#    ADF  -> H0: raíz unitaria (NO estacionaria)
#    KPSS -> H0: estacionaria
# ------------------------------------------------------------
adf.test(inpc$valor)                       # p ~ 0.97 => NO rechaza => no estacionaria
inpc |> features(valor, unitroot_kpss)     # p ~ 0.01 => rechaza    => no estacionaria
# Ambas coinciden: el INPC es I(1).
# ------------------------------------------------------------
# 2. El tipo de cambio: la caminata aleatoria real
# ------------------------------------------------------------
autoplot(tc, valor) + labs(title = "Tipo de cambio (FIX)", y = "Pesos por dólar", x = NULL)
adf.test(tc$valor)                         # p ~ 0.42 => no podemos descartar la raíz unitaria
tc |> features(valor, unitroot_kpss)       # p ~ 0.01 => rechaza => no estacionaria
# ------------------------------------------------------------
# 3. La herramienta del logaritmo
#    El INPC crece exponencial; log() lo vuelve casi lineal y
#    estabiliza la varianza.
# ------------------------------------------------------------
inpc |> autoplot(valor)       + labs(title = "INPC en nivel (exponencial)", x = NULL, y = NULL)
inpc |> autoplot(log(valor))  + labs(title = "log(INPC) (casi lineal)",     x = NULL, y = NULL)
# ------------------------------------------------------------
# 4. Diferenciar para estabilizar
#    difference(log(valor)) = inflación mensual (Sesión 1)
# ------------------------------------------------------------
inpc |>
mutate(infl = difference(log(valor)) * 100) -> inpc
autoplot(inpc, infl) + labs(title = "INPC diferenciado = inflación mensual", y = "%", x = NULL)
# El mismo truco en el tipo de cambio -> rendimientos
tc |>
mutate(r = difference(log(valor)) * 100) -> tc
autoplot(tc, r) + labs(title = "Rendimiento mensual del tipo de cambio", y = "%", x = NULL)
# ------------------------------------------------------------
# 5. Volver a probar sobre la serie transformada
# ------------------------------------------------------------
adf.test(na.omit(inpc$infl))               # p ~ 0.01 => rechaza => ESTACIONARIA
inpc |> filter(!is.na(infl)) |> features(infl, unitroot_kpss)   # p ~ 0.10 => estacionaria
adf.test(na.omit(tc$r))                    # p ~ 0.01 => el rendimiento del TC también es estacionario
# ¿Cuántas diferencias hacían falta? (lo decide solo)
inpc |> features(valor, unitroot_ndiffs)   # => 1
# ------------------------------------------------------------
# 6. ACF y PACF de la inflación (la PACF es nueva: pareja del ACF)
# ------------------------------------------------------------
inpc |> ACF(infl)  |> autoplot() + labs(title = "ACF de la inflación")
inpc |> PACF(infl) |> autoplot() + labs(title = "PACF de la inflación")
# ------------------------------------------------------------
# 7. Una media que se mueve: el IGAE en nivel vs. su crecimiento
# ------------------------------------------------------------
read.csv("Datos/igae_total_mensual.csv") |>
mutate(mes = yearmonth(as.Date(fecha))) |>
as_tsibble(index = mes) |>
mutate(g = (valor / lag(valor, 12) - 1) * 100) -> igae
View(inpc)
View(inpc)
